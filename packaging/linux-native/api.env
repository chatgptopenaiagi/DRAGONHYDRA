# Private API only. The managed service selects its port once and reuses it.
# The selected value is state/managed-port.json; endpoint.json is current readiness.
DRAGONHYDRA_PORT=0
# Optional provider credentials belong in this root-readable file on Linux.
# DRAGONHYDRA_API_FOOTBALL_KEY=
# DRAGONHYDRA_FOOTBALL_DATA_ORG_KEY=
# DRAGONHYDRA_THE_ODDS_API_KEY=
# DRAGONHYDRA_SPORTMONKS_KEY=
