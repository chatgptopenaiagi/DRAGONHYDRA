# VPS administrator: review and install as an sshd_config.d include on a tested OS.
# Validate the complete effective configuration with sshd -t before reloading.
# Match ends at the next Match block or EOF: keep this drop-in last or terminate
# it with Match all as shown. Create only the dedicated unprivileged account.
Match User dragonhydra-tunnel
    AuthenticationMethods publickey
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AllowTcpForwarding remote
    AllowStreamLocalForwarding no
    PermitListen 127.0.0.1:18080
    PermitOpen none
    GatewayPorts no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitTunnel no
    ForceCommand /bin/false
Match all
