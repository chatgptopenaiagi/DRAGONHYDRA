{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "external-browser",
  "description": "Allow the paired loopback dashboard to open web links in the default browser.",
  "windows": ["main"],
  "remote": {"urls": ["http://127.0.0.1:*"]},
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [{"url": "https://*"}, {"url": "http://*"}]
    }
  ]
}
